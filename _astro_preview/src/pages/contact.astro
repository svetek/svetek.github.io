---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contactSections, thanksPath, zohoAction } from '../lib/contact.mjs';
import '../styles/contact.css';

const fieldId = (name: string) => `field-${name}`;
---

<BaseLayout title="Let’s talk | Svetek IT Experts" description="Tell Svetek IT Experts about your team, systems, and what you want to improve. We will follow up to arrange a 15-minute consultation.">
  <Header variant="contact" homePath="/logo/" />
  <main id="top" class="contact-page">
    <div class="container contact-page__grid">
      <div class="contact-intro">
        <p class="eyebrow">Start a conversation</p>
        <h1>Let’s talk.</h1>
        <p class="contact-intro__lead">Tell us a little about your team and what is getting in the way. We will review your answers before we call, so the conversation starts with your priorities.</p>
        <ol class="contact-steps">
          <li><span>01</span><p><strong>Share the basics</strong>About two minutes. Only the marked questions are required.</p></li>
          <li><span>02</span><p><strong>We review and reach out</strong>At the time you prefer, to schedule a 15-minute consultation.</p></li>
          <li><span>03</span><p><strong>Agree on a next step</strong>A clear scope and pricing before any work begins.</p></li>
        </ol>
        <p class="contact-intro__alt">Prefer the phone? <a class="text-link" href="tel:+13607183891">360-718-3891 <span aria-hidden="true">→</span></a></p>
        <p class="contact-intro__client">Already a Svetek client? Use the <a href="https://support.svetek.com/">support portal</a> for urgent issues.</p>
      </div>

      <form class="contact-form" action={zohoAction} method="post" enctype="multipart/form-data" accept-charset="UTF-8" data-contact-form data-thanks={thanksPath}>
        <input type="hidden" name="zf_referrer_name" value="" />
        <input type="hidden" name="zf_redirect_url" value="" />
        <input type="hidden" name="zc_gad" value="" />
        <div class="contact-form__trap" aria-hidden="true">
          <label for="company-website">Leave this field empty</label>
          <input id="company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="contact-form__summary" role="alert" hidden data-error-summary></p>

        {contactSections.map((section) => (
          <fieldset class="contact-form__section">
            <legend>{section.title}</legend>
            <div class="contact-form__fields">
              {section.fields.map((field) => (
                <div class:list={['contact-field', { 'contact-field--half': field.half }]}
                  data-show-field={field.showWhen?.field} data-show-values={field.showWhen?.values.join('|')}>
                  <label for={fieldId(field.name)}>
                    {field.label}
                    {field.required ? <span class="contact-field__required" aria-hidden="true"> *</span> : <span class="contact-field__optional"> (optional)</span>}
                  </label>
                  {field.hint && <p class="contact-field__hint" id={`${fieldId(field.name)}-hint`}>{field.hint}</p>}
                  {field.type === 'select' ? (
                    <select id={fieldId(field.name)} name={field.name} required={field.required && !field.showWhen}
                      aria-describedby={`${fieldId(field.name)}-error`}>
                      <option value="" selected>Choose one</option>
                      {field.options.map((option) => <option value={option}>{option}</option>)}
                    </select>
                  ) : field.type === 'textarea' ? (
                    <textarea id={fieldId(field.name)} name={field.name} rows="3" maxlength="65535" required={field.required}
                      aria-describedby={[field.hint && `${fieldId(field.name)}-hint`, `${fieldId(field.name)}-error`].filter(Boolean).join(' ')} />
                  ) : (
                    <input id={fieldId(field.name)} name={field.name} type={field.type} maxlength="255" required={field.required}
                      autocomplete={field.autocomplete} aria-describedby={`${fieldId(field.name)}-error`} />
                  )}
                  <p class="contact-field__error" id={`${fieldId(field.name)}-error`} hidden></p>
                </div>
              ))}
            </div>
          </fieldset>
        ))}

        <div class="contact-form__footer">
          <button class="button" type="submit" data-submit>Send to Svetek</button>
          <p>Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required. Your answers go directly to the Svetek team.</p>
        </div>
      </form>
    </div>
  </main>
  <Footer homePath="/logo/" />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const trap = form.querySelector<HTMLInputElement>('#company-website')!;
  const selects = [...form.querySelectorAll('select')];
  const controls = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('.contact-field input, .contact-field select, .contact-field textarea')];
  form.noValidate = true;

  // Show conditional questions only for the answers that trigger them in Zoho.
  const conditionals = [...form.querySelectorAll<HTMLElement>('[data-show-field]')];
  const updateConditionals = () => conditionals.forEach((wrapper) => {
    const trigger = form.elements.namedItem(wrapper.dataset.showField!) as HTMLSelectElement;
    const shown = wrapper.dataset.showValues!.split('|').includes(trigger.value);
    const control = wrapper.querySelector('select')!;
    wrapper.hidden = !shown;
    control.required = shown;
    if (!shown) { control.value = ''; control.removeAttribute('aria-invalid'); wrapper.querySelector<HTMLElement>('.contact-field__error')!.hidden = true; }
  });
  conditionals.forEach((wrapper) => form.elements.namedItem(wrapper.dataset.showField!)!.addEventListener('change', updateConditionals));
  updateConditionals();

  const messageFor = (control: (typeof controls)[number]) => {
    if (control.validity.valueMissing) return control instanceof HTMLSelectElement ? 'Choose an option.' : 'This field is required.';
    if (control.validity.typeMismatch) return 'Enter an email address like name@company.com.';
    return '';
  };
  const showError = (control: (typeof controls)[number]) => {
    const error = document.getElementById(`${control.id}-error`)!;
    const message = messageFor(control);
    error.textContent = message;
    error.hidden = !message;
    control.setAttribute('aria-invalid', String(Boolean(message)));
    return !message;
  };
  controls.forEach((control) => control.addEventListener('change', () => {
    if (control.getAttribute('aria-invalid') === 'true') showError(control);
  }));

  form.addEventListener('submit', (event) => {
    controls.forEach((control) => { if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement) control.value = control.value.trim(); });
    const invalid = controls.filter((control) => !showError(control));
    if (invalid.length || trap.value) {
      event.preventDefault();
      if (invalid.length) {
        summary.textContent = `Please check ${invalid.length} ${invalid.length === 1 ? 'field' : 'fields'} below.`;
        summary.hidden = false;
        invalid[0].focus();
      }
      return;
    }
    summary.hidden = true;
    trap.removeAttribute('name');
    form.elements.namedItem('zf_redirect_url')!.setAttribute('value', new URL(form.dataset.thanks!, location.href).href);
    // Zoho treats "-Select-" as an empty dropdown, matching its own template.
    selects.forEach((select) => { if (!select.value) select.options[0].value = '-Select-'; });
    submit.disabled = true;
    submit.textContent = 'Sending…';
  });
  // Undo submit-time changes when the page is restored with the Back button.
  window.addEventListener('pageshow', () => {
    trap.name = 'company_website';
    selects.forEach((select) => { select.options[0].value = ''; });
    submit.disabled = false;
    submit.textContent = 'Send to Svetek';
  });
</script>
