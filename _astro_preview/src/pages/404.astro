---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsSearch from '../components/DocsSearch.astro';
import { contactPath } from '../lib/contact.mjs';
import '../styles/contact.css';
import '../styles/docs.css';
---

<BaseLayout title="Page not found | Svetek IT Experts" description="The page you requested could not be found.">
  <Header homePath="/" />
  <main id="top" class="contact-page contact-thanks">
    <div class="container">
      <p class="eyebrow">404 · Page not found</p>
      <h1>We could not find that page.</h1>
      <p class="contact-intro__lead">It may have moved or been retired. Search the documentation, or tell us what you were looking for.</p>
      <DocsSearch />
      <p class="contact-thanks__actions"><a class="button button--dark" href="/docs/">Browse documentation</a> <a class="text-link" href={contactPath}>Contact Svetek <span aria-hidden="true">→</span></a></p>
    </div>
  </main>
  <Footer homePath="/" />
</BaseLayout>
