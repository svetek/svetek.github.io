---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/contact.css';
---

<BaseLayout title="Thank you | Svetek IT Experts" description="Your answers have been sent to the Svetek team.">
  <Header variant="contact" homePath="/logo/" />
  <main id="top" class="contact-page contact-thanks">
    <div class="container">
      <p class="eyebrow">Received</p>
      <h1>Thank you.</h1>
      <p class="contact-intro__lead">Your answers are with the Svetek team. We will review them and reach out at the time you preferred to schedule a 15-minute consultation.</p>
      <p>Need us sooner? Call <a class="text-link" href="tel:+13607183891">360-718-3891</a>.</p>
      <p class="contact-thanks__actions"><a class="button button--dark" href="/docs/">Browse documentation</a> <a class="text-link" href="/logo/">Back to home <span aria-hidden="true">→</span></a></p>
    </div>
  </main>
  <Footer homePath="/logo/" />
</BaseLayout>
