---
import BaseLayout from './BaseLayout.astro';
import DocsHeader from '../components/DocsHeader.astro';
import DocsSearch from '../components/DocsSearch.astro';
import DocsNavigation from '../components/DocsNavigation.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbsFor, childrenOf, canonicalUrl, ctaFor, landingSections } from '../lib/docs.mjs';
import { contactPath } from '../lib/contact.mjs';
import '../styles/docs.css';

const { page } = Astro.props;
const crumbs = breadcrumbsFor(page.url);
const children = childrenOf(page.url);
const isLanding = page.url === '/docs/';
const indexChildren = isLanding ? landingSections() : children;
const canonical = page.data.canonical || canonicalUrl(page.url);
const seoTitle = page.data.seo_title || page.title;
const title = seoTitle.includes('Svetek Documentation') ? seoTitle : `${seoTitle} | Svetek Documentation`;
const cta = ctaFor(page);
const showCTA = !children.length && page.url.startsWith('/docs/Configuration/') && !page.data.hide_article_contact_footer;
const schema = [
  { '@context': 'https://schema.org', '@type': children.length ? 'CollectionPage' : 'WebPage',
    name: page.title, description: page.description, url: canonical },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({ '@type': 'ListItem', position: index + 1,
      name: crumb.title, item: canonicalUrl(crumb.url) })) },
];
---
<BaseLayout title={title} description={page.description} canonical={canonical} metadata={page.data} schema={schema}>
  <div class="docs-site">
    <DocsHeader />
    <div class:list={['docs-shell', { 'docs-shell--landing': isLanding }]}>
      {!isLanding && <aside class="docs-sidebar">
        <DocsSearch compact />
        <div class="docs-navigation docs-navigation--desktop">
          <DocsNavigation page={page} />
        </div>
        <details class="docs-navigation docs-navigation--mobile">
          <summary>Browse documentation</summary>
          <DocsNavigation page={page} />
        </details>
      </aside>}
      <main id="main-content" class="docs-main">
        <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
          <ol>{crumbs.map((crumb, index) => <li>{index < crumbs.length - 1
            ? <a href={crumb.url}>{crumb.title}</a> : <span aria-current="page">{crumb.title}</span>}</li>)}</ol>
        </nav>
        <header class="docs-title">
          <p class="eyebrow">{isLanding ? 'The Svetek knowledge base' : children.length ? 'Browse by topic' : 'Svetek documentation'}</p>
          <h1>{page.title}</h1>
          {(!page.html || isLanding) && <p>{page.description}</p>}
        </header>
        {isLanding && <DocsSearch />}
        <div class="docs-prose" data-article-body set:html={page.html} />
        {children.length > 0 && <section class="docs-index" aria-label="Browse articles and topics">
          <h2>{isLanding ? 'What can we help you with?' : 'Articles and topics'}</h2>
          <div class="docs-card-grid">{indexChildren.map((child) => <a class="docs-card" href={child.url}>
            <h3>{child.title}<span aria-hidden="true"> ↗</span></h3>
            <p>{child.description}</p>
            {childrenOf(child.url).length > 0 && <span class="docs-card__count">{childrenOf(child.url).length} articles &amp; topics</span>}
          </a>)}</div>
        </section>}
        {showCTA && <aside class="docs-cta" aria-label="Get help with this configuration">
          <p class="eyebrow">Business IT. Solved.</p>
          <h2>{cta.title}</h2>
          <p>{cta.description} Svetek provides managed IT services from Vancouver, Washington.</p>
          <div><a class="button" href={contactPath}>Discuss your needs &amp; pricing</a>
            <a class="text-link" href={cta.service_url}>{cta.service_label}</a></div>
          <p class="docs-cta__client">Already a client? <a href="https://support.svetek.com/">Open the support portal</a> or <a href={cta.phone_url}>call {cta.phone}</a>.</p>
        </aside>}
        {!showCTA && !children.length && !page.data.hide_article_contact_footer && <p class="docs-support">Need help? <a href="https://support.svetek.com/">Existing-client support</a> · <a href={contactPath}>Talk with Svetek</a></p>}
      </main>
      {!isLanding && page.headings.length > 0 && !page.data.notoc && <aside class="docs-toc">
        <nav aria-label="On this page"><p>On this page</p><ul>{page.headings.map((heading) =>
          <li class:list={{ 'docs-toc__sub': heading.depth === 3 }}><a href={`#${heading.id}`}>{heading.text}</a></li>)}</ul></nav>
      </aside>}
    </div>
    <Footer homePath="/" />
  </div>
</BaseLayout>
