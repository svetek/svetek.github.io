---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import AIReadiness from '../components/AIReadiness.astro';
import Approach from '../components/Approach.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';

const title = 'Business IT Support in Vancouver, WA | Svetek IT Experts';
const description = 'Managed IT, cybersecurity, backup, cloud, and AI readiness services for growing businesses in Vancouver, Washington.';
const { variant = 'photo' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class:list={['home', 'home--' + variant]}>
  <Header variant={variant} />
  <main>
    <Hero variant={variant} />
    <Services />
    <AIReadiness />
    <Approach />
    <ContactCTA />
  </main>
  <Footer />
  </div>
</BaseLayout>
