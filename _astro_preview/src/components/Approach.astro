---
const steps = [
  ['Understand', 'We learn how your team works, what is failing, and which risks matter most.'],
  ['Stabilize', 'We address urgent gaps and document the systems, accounts, and vendors involved.'],
  ['Improve', 'We prioritize practical changes that make support, security, and recovery more predictable.'],
];
---

<section class="section approach" id="approach">
  <div class="container approach__grid">
    <div class="approach__intro">
      <p class="eyebrow">How we work</p>
      <h2>Clear priorities. Documented systems. Fewer surprises.</h2>
      <p>People, process, and technology—working together, not in isolation. We start with how your team works, establish repeatable processes, and put the right technology behind them.</p>
    </div>
    <div class="approach__steps">
      {steps.map(([title, description], index) => (
        <article>
          <span>0{index + 1}</span>
          <div><h3>{title}</h3><p>{description}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="documentation-callout" id="documentation">
  <div class="container documentation-callout__inner">
    <div>
      <p class="eyebrow">See the work</p>
      <h2>Practical IT guidance, openly shared.</h2>
      <p>Explore selected guides, configuration procedures, and troubleshooting resources in our public knowledge base. Client-specific documentation, credentials, network details, and internal operating records remain private.</p>
    </div>
    <a class="button button--dark" href="/docs/">Browse documentation</a>
  </div>
</section>
