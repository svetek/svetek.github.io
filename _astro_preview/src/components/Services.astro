---
const services = [
  {
    number: '01',
    title: 'IT support & management',
    description: 'Keep employees productive and business technology maintained without building a full internal IT department.',
    points: ['Responsive help desk', 'Device and account management', 'Vendor coordination and planning'],
    href: 'https://svetek.com/services/it-support-services/',
  },
  {
    number: '02',
    title: 'Cybersecurity',
    description: 'Reduce preventable risk with practical controls for identities, devices, email, networks, and business data.',
    points: ['Identity and access protection', 'Endpoint and email security', 'Security reviews and remediation'],
    href: 'https://svetek.com/services/cybersecurity-services/',
  },
  {
    number: '03',
    title: 'Backup & recovery',
    description: 'Protect critical information and prepare the business to recover from equipment, account, or service failures.',
    points: ['Cloud and endpoint backup', 'Recovery planning and testing', 'Business continuity coordination'],
    href: 'https://svetek.com/services/data-backup-and-recovery-service/',
  },
  {
    number: '04',
    title: 'Cloud services',
    description: 'Configure and manage cloud platforms so employees can collaborate securely from the office or remotely.',
    points: ['Microsoft 365 administration', 'Migration and configuration', 'Secure remote collaboration'],
    href: 'https://svetek.com/services/cloud-solutions/',
  },
];
---

<section class="section services" id="services">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">What we manage</p>
        <h2>Technology that supports the work—not the other way around.</h2>
      </div>
      <p>Use Svetek as your IT team or extend the team you already have. We connect daily support with security, resilience, and cloud planning.</p>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <span class="service-card__number">{service.number}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul>
            {service.points.map((point) => <li>{point}</li>)}
          </ul>
          <a class="text-link" href={service.href}>Explore this service <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
