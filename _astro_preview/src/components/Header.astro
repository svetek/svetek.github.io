---
import Brand from './Brand.astro';
import { contactPath } from '../lib/contact.mjs';
const { current = '', homePath = '' } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href={`${homePath}#top`} aria-label="Svetek IT Experts home">
      <Brand />
    </a>
    <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
      <a href={`${homePath}#services`}>Services</a>
      <a href={`${homePath}#ai-readiness`}>AI readiness</a>
      <a href={`${homePath}#approach`}>Our approach</a>
      <a href="/docs/">Documentation</a>
    </nav>
    <details class="site-mobile-menu">
      <summary>
        <span class="site-mobile-menu__icon" aria-hidden="true"></span>
        <span class="site-mobile-menu__label">Menu</span>
      </summary>
      <nav class="site-mobile-nav" aria-label="Mobile navigation">
        <a href={`${homePath}#services`}>Services</a>
        <a href={`${homePath}#ai-readiness`}>AI readiness</a>
        <a href={`${homePath}#approach`}>Our approach</a>
        <a href="/docs/">Documentation</a>
      </nav>
    </details>
    <a class="button button--small" href={contactPath} aria-current={current === 'contact' ? 'page' : undefined}>Let’s talk</a>
  </div>
</header>
