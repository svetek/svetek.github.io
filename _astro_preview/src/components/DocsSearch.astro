---
const { compact = false } = Astro.props;
---
<form class:list={['docs-search', { 'docs-search--compact': compact }]} action="/search/" role="search">
  <label for={compact ? 'sidebar-search' : 'documentation-search'}>Search documentation</label>
  <div>
    <input id={compact ? 'sidebar-search' : 'documentation-search'} name="q" type="search" placeholder="Search guides, products, or an error…" required />
    <button type="submit" aria-label="Search documentation">Search <span aria-hidden="true">→</span></button>
  </div>
</form>
