{
  "name": "astro-preview",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "predev": "npm run prepare:docs",
    "dev": "astro dev",
    "prebuild": "npm run prepare:docs",
    "build": "astro build",
    "check:docs": "node scripts/check-docs.mjs",
    "preview": "astro preview",
    "pages:dev": "wrangler pages dev --port 8788",
    "deploy:preview": "npm run build && npm run check:docs && wrangler pages deploy --branch=migration-preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "html-escaper": "^3.0.3",
    "ultrahtml": "^1.7.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
